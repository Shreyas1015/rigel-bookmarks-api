{
  "name": "rigel-typescript-template",
  "version": "0.0.1",
  "description": "Express + TypeScript + Sequelize Rigel template",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch src/runtime/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/runtime/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:arch": "NODE_OPTIONS=--experimental-vm-modules jest tests/architecture/",
    "assert:tests": "NODE_OPTIONS=--experimental-vm-modules jest tests/architecture/ --json --outputFile=.rigel/.jest-count.json && node scripts/assert-tests-ran.mjs .rigel/.jest-count.json",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "load:smoke": "k6 run tests/load/smoke.js",
    "load:stress": "k6 run tests/load/stress.js",
    "load:soak": "k6 run tests/load/soak.js",
    "lint": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check:circular": "madge --circular src/ --extensions ts",
    "gate": "npm run typecheck && npm run lint && npm run check:circular && npm run test:arch && npm run assert:tests",
    "redgreen:record": "node scripts/redgreen-record.mjs",
    "ac:vector": "node scripts/ac-vector.mjs",
    "gate:final": "npm run gate && npm run ac:vector",
    "audit": "npm audit --omit=dev --audit-level=high",
    "openapi:export": "tsx scripts/openapi.export.ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all"
  },
  "keywords": [
    "express",
    "typescript",
    "sequelize",
    "rigel"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "argon2": "^0.45.0",
    "bullmq": "^5.80.9",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "rate-limit-redis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "jest": "^30.4.2",
    "lint-staged": "^17.1.0",
    "madge": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  }
}
